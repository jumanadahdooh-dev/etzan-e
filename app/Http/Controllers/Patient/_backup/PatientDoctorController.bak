        return collect($samples)->map(function ($doctor, $index) {
            return [
                'id' => $index + 1,
                'is_fallback' => true,
                'name' => $doctor['name'],
                'specialty' => $doctor['specialty'],
                'avatar' => $this->placeholderImage($doctor['name']),
                'bio' => 'طبيب مختص يساعدك على بناء متابعة صحية مناسبة لحالتك وهدفك.',
                'gender' => $doctor['gender'],
                'gender_label' => $doctor['gender'] === 'female' ? 'طبيبة' : 'طبيب',
                'consultation_key' => $index === 1 ? 'clinic' : 'online',
                'consultation_type' => $index === 1 ? 'حضوري' : 'أونلاين',
                'experience' => 5 + $index,
                'rating' => number_format(4.8 - ($index * 0.1), 1),
                'reviews_count' => 0,
                'match_score' => $doctor['score'],
                'match_reason' => $doctor['reason'],
                'badges' => $doctor['badges'],
                'articles' => [
                    ['title' => 'كيف تبدأ متابعة صحية بطريقة بسيطة؟', 'read_time' => '4 دقائق قراءة'],
                    ['title' => 'أخطاء شائعة في تنظيم الوجبات اليومية', 'read_time' => '5 دقائق قراءة'],
                ],
            ];
        })->toArray();
    }

    private function doctorReviewSummary(int $doctorProfileId): array
    {
        if (!$this->tableExists('doctor_reviews')) {
            return [
                'average' => '4.8',
                'count' => 0,
            ];
        }

        $count = DB::table('doctor_reviews')
            ->where('doctor_profile_id', $doctorProfileId)
            ->count();

        $average = DB::table('doctor_reviews')
            ->where('doctor_profile_id', $doctorProfileId)
            ->avg('rating');

        return [
            'average' => $count > 0 ? number_format((float) $average, 1) : '4.8',
            'count' => (int) $count,
        ];
    }

    private function doctorArticles(int $doctorProfileId, ?int $doctorUserId = null): array
    {
        if (!$this->tableExists('articles')) {
            return [];
        }

        $query = DB::table('articles');

        if ($this->columnExists('articles', 'doctor_profile_id')) {
            $query->where('doctor_profile_id', $doctorProfileId);
        } elseif ($doctorUserId && $this->columnExists('articles', 'user_id')) {
            $query->where('user_id', $doctorUserId);
        } elseif ($doctorUserId && $this->columnExists('articles', 'author_id')) {
            $query->where('author_id', $doctorUserId);
        } else {
            return [];
        }

        if ($this->columnExists('articles', 'status')) {
            $query->whereIn('status', ['published', 'approved']);
        }

        if ($this->columnExists('articles', 'published_at')) {
            $query->orderByDesc('published_at');
        } elseif ($this->columnExists('articles', 'created_at')) {
            $query->orderByDesc('created_at');
        }

        return $query
            ->limit(3)
            ->get()
            ->map(function ($article) {
                return [
                    'title' => $article->title ?? 'مقال صحي',
                    'read_time' => isset($article->reading_minutes)
                        ? ((int) $article->reading_minutes) . ' دقائق قراءة'
                        : 'قراءة قصيرة',
                ];
            })
            ->toArray();
    }

    private function doctorSpecialty(int $doctorProfileId): string
    {
        if (!$this->tableExists('doctor_specialty') || !$this->tableExists('specialties')) {
            return 'استشاري صحي';
        }

        $specialty = DB::table('doctor_specialty')
            ->join('specialties', 'specialties.id', '=', 'doctor_specialty.specialty_id')
            ->where('doctor_specialty.doctor_profile_id', $doctorProfileId)
            ->value('specialties.name');

        return $specialty ?: 'استشاري صحي';
    }

    private function hasRealDailyPlan(?int $userId, ?int $profileId): bool
    {
        if (!$this->tableExists('patient_tasks') || !$this->columnExists('patient_tasks', 'patient_id')) {
            return false;
        }

        $ids = array_values(array_unique(array_filter([
            $userId,
            $profileId,
        ])));

        if (empty($ids)) {
            return false;
        }

        $query = DB::table('patient_tasks')
            ->whereIn('patient_id', $ids);

        if ($this->columnExists('patient_tasks', 'due_date')) {
            $query->where(function ($subQuery) {
                $subQuery
                    ->whereDate('due_date', Carbon::today())
                    ->orWhereNull('due_date');
            });
        }

        return $query->exists();
    }

    private function todayTasks($user, ?object $profile): array
    {
        if (!$this->tableExists('patient_tasks') || !$this->columnExists('patient_tasks', 'patient_id')) {
            return $this->fallbackTasks();
        }

        $ids = array_values(array_unique(array_filter([
            $user?->id,
            $profile?->id,
        ])));

        if (empty($ids)) {
            return $this->fallbackTasks();
        }

        $query = DB::table('patient_tasks')
            ->whereIn('patient_id', $ids);

        if ($this->columnExists('patient_tasks', 'due_date')) {
            $query->where(function ($subQuery) {
                $subQuery
                    ->whereDate('due_date', Carbon::today())
                    ->orWhereNull('due_date');
            });
        }

        if ($this->columnExists('patient_tasks', 'status')) {
            $query->orderByRaw("CASE WHEN status IN ('completed', 'done') THEN 1 ELSE 0 END ASC");
        }

        if ($this->columnExists('patient_tasks', 'completed_at')) {
            $query->orderByRaw('CASE WHEN completed_at IS NULL THEN 0 ELSE 1 END ASC');
        }

        if ($this->columnExists('patient_tasks', 'due_date')) {
            $query->orderBy('due_date');
        }

        $rows = $query->limit(8)->get();

        if ($rows->isEmpty()) {
            return $this->fallbackTasks();
        }

        return $rows->map(function ($task) {
            $completed = false;

            if (isset($task->status) && in_array($task->status, ['completed', 'done'], true)) {
                $completed = true;
            }

            if (isset($task->completed_at) && !empty($task->completed_at)) {
                $completed = true;
            }

            $title = $task->title ?? 'مهمة صحية';

            return [
                'title' => $title,
                'description' => $task->description ?? null,
                'completed' => $completed,
                'time' => $this->timeFromDate($task->due_date ?? null),
                'type' => $task->type ?? 'task',
                'icon' => $this->taskIcon(($task->type ?? null) ?: $title),
                'progress' => $completed ? 100 : 0,
                'progressText' => $completed ? 'مكتملة' : 'بانتظار التنفيذ',
            ];
        })->toArray();
    }

    private function journeyTasks(array $tasks): array
    {
        return collect($tasks)->take(8)->map(function ($task) {
            return [
                'title' => $task['title'],
                'time' => $task['time'] ?: '—',
                'progressText' => $task['progressText'] ?? ($task['completed'] ? 'مكتملة' : 'بانتظار التنفيذ'),
                'progress' => $task['progress'] ?? ($task['completed'] ? 100 : 0),
                'completed' => $task['completed'],
                'icon' => $task['icon'] ?? 'circle-check',
            ];
        })->values()->toArray();
    }

    private function fallbackTasks(): array
    {
        return [
            ['title' => 'شرب 8 أكواب ماء', 'description' => null, 'completed' => false, 'time' => '12:00', 'type' => 'water', 'icon' => 'droplet', 'progress' => 0, 'progressText' => '0/8 أكواب'],
            ['title' => 'تسجيل وجبة اليوم', 'description' => null, 'completed' => false, 'time' => '13:00', 'type' => 'meal', 'icon' => 'utensils', 'progress' => 0, 'progressText' => '0/3 وجبات'],
            ['title' => 'تسجيل الوزن', 'description' => null, 'completed' => false, 'time' => '—', 'type' => 'weight', 'icon' => 'scale', 'progress' => 0, 'progressText' => 'بانتظار التنفيذ'],
            ['title' => '30 دقيقة مشي', 'description' => null, 'completed' => false, 'time' => '16:30', 'type' => 'activity', 'icon' => 'activity', 'progress' => 0, 'progressText' => '0/30 دقيقة'],
        ];
    }

    private function latestMessages(?int $userId): array
    {
        if (!$userId || !$this->tableExists('conversations') || !$this->tableExists('messages')) {
            return [];
        }

        if (!$this->columnExists('conversations', 'user_id') || !$this->columnExists('messages', 'conversation_id')) {
            return [];
        }

        $conversationIds = DB::table('conversations')
            ->where('user_id', $userId)
            ->pluck('id')
            ->toArray();

        if (empty($conversationIds)) {
            return [];
        }

        return DB::table('messages')
            ->whereIn('conversation_id', $conversationIds)
            ->latest()
            ->limit(3)
            ->get()
            ->map(function ($message) use ($userId) {
                return [
                    'sender' => ($message->sender_id ?? null) === $userId ? 'أنت' : $this->senderName($message->sender_type ?? null),
                    'body' => $message->body ?? '',
                    'time' => $this->humanTime($message->created_at ?? null),
                    'avatar' => ($message->sender_id ?? null) === $userId
                        ? null
                        : $this->placeholderImage('رسالة'),
                ];
            })
            ->toArray();
    }

    private function unreadMessagesCount(?int $userId): int
    {
        if (!$userId || !$this->tableExists('conversations') || !$this->tableExists('messages')) {
            return 0;
        }

        if (!$this->columnExists('conversations', 'user_id') || !$this->columnExists('messages', 'conversation_id')) {
            return 0;
        }

        $conversationIds = DB::table('conversations')
            ->where('user_id', $userId)
            ->pluck('id')
            ->toArray();

        if (empty($conversationIds)) {
            return 0;
        }

        $query = DB::table('messages')
            ->whereIn('conversation_id', $conversationIds);

        if ($this->columnExists('messages', 'sender_id')) {
            $query->where('sender_id', '!=', $userId);
        }

        if ($this->columnExists('messages', 'is_read')) {
            $query->where('is_read', false);
        } elseif ($this->columnExists('messages', 'read_at')) {
            $query->whereNull('read_at');
        } else {
            return 0;
        }

        return (int) $query->count();
    }

    private function notificationsCount(array $tasks): int
    {
        return collect($tasks)->where('completed', false)->count();
    }

    private function dashboardArticles(): array
    {
        if (!$this->tableExists('articles')) {
            return $this->fallbackArticles();
        }

        $query = DB::table('articles');

        $select = ['articles.title'];

        foreach (['cover_image', 'reading_minutes', 'status', 'published_at', 'created_at'] as $column) {
            if ($this->columnExists('articles', $column)) {
                $select[] = 'articles.' . $column;
            }
        }

        if ($this->tableExists('article_categories') && $this->columnExists('articles', 'article_category_id')) {
            $query->leftJoin('article_categories', 'article_categories.id', '=', 'articles.article_category_id');
            $select[] = 'article_categories.name as category_name';
        }

        $query->select($select);

        if ($this->columnExists('articles', 'status')) {
            $query->whereIn('articles.status', ['published', 'approved']);
        }

        if ($this->columnExists('articles', 'is_featured')) {
            $query->orderByDesc('articles.is_featured');
        }

        if ($this->columnExists('articles', 'published_at')) {
            $query->orderByDesc('articles.published_at');
        } elseif ($this->columnExists('articles', 'created_at')) {
            $query->orderByDesc('articles.created_at');
        }

        $rows = $query->limit(3)->get();

        if ($rows->isEmpty()) {
            return $this->fallbackArticles();
        }

        return $rows->map(function ($article) {
            return [
                'title' => $article->title ?? 'مقال صحي',
                'tag' => $article->category_name ?? 'صحة',
                'read_time' => ((int) ($article->reading_minutes ?? 5)) . ' دقائق قراءة',
                'image' => $this->imageUrl($article->cover_image ?? null) ?: $this->placeholderImage($article->title ?? 'مقال'),
            ];
        })->toArray();
    }

    private function fallbackArticles(): array
    {
        return [
            ['title' => '5 طرق فعالة لتقليل التوتر في يومك', 'tag' => 'صحة نفسية', 'read_time' => '5 دقائق قراءة', 'image' => $this->placeholderImage('تأمل')],
            ['title' => 'أطعمة تعزز المناعة بطريقة طبيعية', 'tag' => 'تغذية', 'read_time' => '4 دقائق قراءة', 'image' => $this->placeholderImage('سلطة')],
            ['title' => 'تمارين صباحية بسيطة لنشاط أفضل', 'tag' => 'نشاط', 'read_time' => '6 دقائق قراءة', 'image' => $this->placeholderImage('نشاط')],
        ];
    }

    private function homeStats(?object $profile, int $todayProgress): array
    {
        $weight = $this->valueFrom($profile, ['weight_kg', 'current_weight', 'weight']);

        return [
            ['title' => 'السعرات المتبقية', 'value' => '2,000', 'unit' => 'سعرة', 'subtitle' => 'ابدأ بتحليل أول وجبة', 'icon' => 'flame', 'progress' => 0, 'color' => 'green'],
            ['title' => 'شرب الماء', 'value' => '0', 'unit' => 'أكواب', 'subtitle' => 'من 8 أكواب', 'icon' => 'droplet', 'progress' => 0, 'color' => 'blue'],
            ['title' => 'مهام اليوم', 'value' => $todayProgress, 'unit' => '%', 'subtitle' => 'نسبة الإنجاز', 'icon' => 'badge-check', 'progress' => $todayProgress, 'color' => 'green'],
            ['title' => 'النشاط البدني', 'value' => '0', 'unit' => 'دقيقة', 'subtitle' => 'سجل نشاطك اليومي', 'icon' => 'activity', 'progress' => 0, 'color' => 'blue'],
            ['title' => 'الوزن', 'value' => $weight ?: '—', 'unit' => $weight ? 'كغ' : '', 'subtitle' => $weight ? 'آخر وزن مسجل' : 'لم يتم تسجيل الوزن', 'icon' => 'scale', 'progress' => $weight ? 65 : 0, 'color' => 'purple'],
        ];
    }

    private function timeline(): array
    {
        return [
            'صباحاً' => [
                ['time' => '08:00', 'title' => 'شرب كوب ماء', 'subtitle' => 'ابدأ يومك بهدوء', 'icon' => 'droplet'],
                ['time' => '08:30', 'title' => 'فطور متوازن', 'subtitle' => 'سجل الوجبة بعد تناولها', 'icon' => 'utensils'],
            ],
            'ظهراً' => [
                ['time' => '13:00', 'title' => 'تحليل وجبة الغداء', 'subtitle' => 'استخدم الذكاء الاصطناعي', 'icon' => 'sparkles'],
                ['time' => '13:30', 'title' => 'تحديث المهام', 'subtitle' => 'راجع تقدمك', 'icon' => 'list-checks'],
            ],
            'مساءً' => [
                ['time' => '16:30', 'title' => 'المشي', 'subtitle' => '30 دقيقة نشاط خفيف', 'icon' => 'activity'],
                ['time' => '22:30', 'title' => 'الاستعداد للنوم', 'subtitle' => 'راحة كافية لجسمك', 'icon' => 'moon'],
            ],
        ];
    }

    private function taskIcon(?string $value): string
    {
        $value = mb_strtolower((string) $value);

        return match (true) {
            Str::contains($value, ['water', 'ماء', 'شرب']) => 'droplet',
            Str::contains($value, ['meal', 'وجبة', 'أكل', 'غداء', 'فطور']) => 'utensils',
            Str::contains($value, ['weight', 'وزن']) => 'scale',
            Str::contains($value, ['activity', 'walk', 'مشي', 'نشاط']) => 'activity',
            Str::contains($value, ['sleep', 'نوم']) => 'moon',
            Str::contains($value, ['medicine', 'دواء']) => 'pill',
            default => 'circle-check',
        };
    }

    private function senderName(?string $senderType): string
    {
        return match ($senderType) {
            'admin' => 'فريق اتزان',
            'doctor' => 'الطبيب',
            default => 'اتزان',
        };
    }

    private function todayDate(): string
    {
        return Carbon::now()->locale('ar')->translatedFormat('l، d F Y');
    }

    private function timeFromDate($date): ?string
    {
        if (!$date) {
            return null;
        }

        try {
            return Carbon::parse($date)->format('H:i');
        } catch (\Throwable) {
            return null;
        }
    }

    private function humanTime($date): string
    {
        if (!$date) {
            return 'الآن';
        }

        try {
            return Carbon::parse($date)->locale('ar')->diffForHumans();
        } catch (\Throwable) {
            return 'الآن';
        }
    }

    private function patientDisplayName($user, ?object $profile): string
    {
        $nameFromProfile = $this->valueFrom($profile, ['full_name', 'patient_name', 'name']);

        if ($this->filledValue($nameFromProfile)) {
            return trim((string) $nameFromProfile);
        }

        $userName = $user?->name;

        if ($this->filledValue($userName)) {
            $lower = mb_strtolower(trim((string) $userName), 'UTF-8');

            if (!in_array($lower, ['admin', 'administrator', 'مدير'], true)) {
                return trim((string) $userName);
            }
        }

        return 'مريض اتزان';
    }

    private function patientAvatar($user, ?object $profile): ?string
    {
        $avatar = null;

        if ($user) {
            foreach (['avatar', 'profile_photo_path', 'image', 'photo'] as $column) {
                if (isset($user->{$column}) && $this->filledValue($user->{$column})) {
                    $avatar = $user->{$column};
                    break;
                }
            }
        }

        if (!$avatar && $profile) {
            $avatar = $this->valueFrom($profile, ['avatar', 'profile_photo', 'photo', 'image', 'profile_photo_path']);
        }

        return $this->imageUrl($avatar);
    }

    private function imageUrl(?string $path): ?string
    {
        if (!$path) {
            return null;
        }

        if (Str::startsWith($path, ['http://', 'https://', 'data:image'])) {
            return $path;
        }

        if (Str::startsWith($path, ['storage/', '/storage/'])) {
            return asset(ltrim($path, '/'));
        }

        return asset('storage/' . ltrim($path, '/'));
    }

    private function valueFrom(?object $row, array $columns, mixed $default = null): mixed
    {
        if (!$row) {
            return $default;
        }

        foreach ($columns as $column) {
            if (property_exists($row, $column) && $row->{$column} !== null && $row->{$column} !== '') {
                return $row->{$column};
            }
        }

        return $default;
    }

    private function filledValue(mixed $value): bool
    {
        if ($value === null) {
            return false;
        }

        if (is_string($value)) {
            return trim($value) !== '';
        }

        if (is_array($value)) {
            return count($value) > 0;
        }

        return true;
    }

    private function decodeArrayValue(mixed $value): array
    {
        if (!$value) {
            return [];
        }

        if (is_array($value)) {
            return $value;
        }

        if (is_string($value)) {
            $decoded = json_decode($value, true);

            if (is_array($decoded)) {
                return $decoded;
            }

            return array_values(array_filter(array_map('trim', explode(',', $value))));
        }

        return [];
    }

    private function setFirstExistingColumn(array &$payload, string $table, array $columns, mixed $value): void
    {
        foreach ($columns as $column) {
            if ($this->columnExists($table, $column)) {
                $payload[$column] = $value;
                return;
            }
        }
    }

    private function tableExists(string $table): bool
    {
        static $cache = [];

        if (!array_key_exists($table, $cache)) {
            $cache[$table] = Schema::hasTable($table);
        }

        return $cache[$table];
    }

    private function columnExists(string $table, string $column): bool
    {
        static $cache = [];

        $key = $table . '.' . $column;

        if (!array_key_exists($key, $cache)) {
            $cache[$key] = Schema::hasTable($table) && Schema::hasColumn($table, $column);
        }

        return $cache[$key];
    }

    private function validNumber(mixed $value, float $min, float $max): bool
    {
        if ($value === null || $value === '') {
            return false;
        }

        if (!is_numeric($value)) {
            return false;
        }

        $number = (float) $value;

        return $number >= $min && $number <= $max;
    }

    private function normalizeGender(mixed $value): string
    {
        $value = mb_strtolower(trim((string) $value), 'UTF-8');

        return match ($value) {
            'female', 'woman', 'f', 'أنثى', 'طبيبة' => 'female',
            'male', 'man', 'm', 'ذكر', 'طبيب' => 'male',
            default => 'unknown',
        };
    }

    private function normalizeConsultationType(mixed $value): string
    {
        $value = mb_strtolower(trim((string) $value), 'UTF-8');

        return match ($value) {
            'clinic', 'offline', 'حضوري', 'عيادة' => 'clinic',
            'online', 'remote', 'virtual', 'أونلاين', 'اونلاين' => 'online',
            default => 'online',
        };
    }

    private function placeholderImage(string $text): string
    {
        $safeText = htmlspecialchars(mb_substr($text, 0, 18, 'UTF-8'), ENT_QUOTES, 'UTF-8');

        $svg = <<<SVG
<svg xmlns="http://www.w3.org/2000/svg" width="520" height="320" viewBox="0 0 520 320">
  <defs>
    <linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#EAF8F4"/>
      <stop offset="100%" stop-color="#DFF1FA"/>
    </linearGradient>
  </defs>
  <rect width="520" height="320" rx="38" fill="url(#g)"/>
  <circle cx="420" cy="72" r="68" fill="#FFFFFF" opacity=".55"/>
  <circle cx="96" cy="248" r="80" fill="#1D9E75" opacity=".11"/>
  <rect x="135" y="92" width="250" height="136" rx="34" fill="#FFFFFF" opacity=".72"/>
  <text x="260" y="170" text-anchor="middle" font-family="Arial" font-size="26" font-weight="800" fill="#18333B">$safeText</text>
</svg>
SVG;

        return 'data:image/svg+xml;utf8,' . rawurlencode($svg);
    }
}
