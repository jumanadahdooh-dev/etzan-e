            [
                'name' => 'د. أحمد سالم',
                'specialty' => 'تغذية علاجية وسكري',
                'score' => 94,
                'reason' => 'مناسب لمتابعة التغذية العلاجية وتنظيم الوجبات حسب الحالة الصحية.',
                'badges' => ['تغذية علاجية', 'سكري', 'متابعة غذائية'],
                'gender' => 'male',
            ],
            [
                'name' => 'د. ليان منصور',
                'specialty' => 'صحة عامة وأمراض مزمنة',
                'score' => 91,
                'reason' => 'مناسبة للمتابعة اليومية وتنظيم العادات الصحية لأصحاب الحالات المزمنة.',
                'badges' => ['أمراض مزمنة', 'ضغط', 'نمط حياة'],
                'gender' => 'female',
            ],
            [
                'name' => 'د. سامر خليل',
                'specialty' => 'تغذية وسمنة ونمط حياة',
                'score' => 86,
                'reason' => 'مناسب لبناء خطة صحية متدرجة ومتابعة الوزن والعادات اليومية.',
